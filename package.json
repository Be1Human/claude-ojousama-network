{
  "name": "claude-ojousama-network",
  "version": "0.1.0",
  "description": "大小姐的网络手账 — a local-first Claude Code network observatory",
  "author": "Be1Human",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/ui-smoke.js",
    "test:live": "node scripts/live-smoke.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64",
    "icons": "node scripts/icons.js"
  },
  "dependencies": {
    "https-proxy-agent": "9.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "io.github.be1human.claude-ojousama-network",
    "productName": "Claude Ojou Network",
    "artifactName": "Claude-Ojou-Network-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Be1Human",
        "repo": "claude-ojousama-network"
      }
    ]
  }
}
